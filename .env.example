# Saleor API URL (required) - keep the trailing slash
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8001/graphql/

# Storefront URL - set on production for correct canonical URLs and OG images
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Channel slug (required) - your Saleor channel identifier
# The root "/" redirects to this channel (e.g., "/default-channel")
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# App token (optional) - enables multi-channel builds by discovering additional channels
# SALEOR_APP_TOKEN=

# AI search assistant (storefront overlay + Saleor keyword search)
# NEXT_PUBLIC_AI_SEARCH_ENABLED=true

# Shopping assistant (optional) - kpure-ai chat API for AI recommendations
# Prefer server-only CHATBOT_API_URL (read by layout → /api/assist proxy). No rebuild needed.
# CHATBOT_API_URL=https://ai.kayapure.com
# CHATBOT_DEFAULT_MODEL=gemini-flash
# Optional public override/flag if you need chatEnabled without server config:
# NEXT_PUBLIC_AI_CHAT_ENABLED=true
# NEXT_PUBLIC_CHATBOT_API_URL=https://ai.kayapure.com

# Homepage video gallery — optional CDN origin for paths in src/config/home-video-gallery.ts
# NEXT_PUBLIC_VIDEO_CDN_BASE_URL=https://cdn.kayapure.com
